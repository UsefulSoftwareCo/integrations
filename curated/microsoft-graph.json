  "slug": "microsoft-graph",
  "name": "Microsoft Graph",
  "tagline": "Outlook, OneDrive, Teams, SharePoint, and the rest of Microsoft 365 behind one API and one OAuth consent.",
  "description": "Microsoft Graph is the single REST API for Microsoft 365: Outlook mail and calendar, OneDrive, Teams, SharePoint, To Do, and the Entra directory all live under graph.microsoft.com/v1.0 and share one OAuth flow. The per-product specs below are self-contained slices of Microsoft's published OpenAPI description, hosted here because the upstream document is a 43 MB monolith no client should have to download.",
  "domain": "graph.microsoft.com",
  "icon": "https://svgl.app/library/microsoft.svg",
  "categories": [
    "productivity",
    "collaboration",
    "email",
    "documents"
  ],
  "auth": {
    "methods": [
      {
        "type": "oauth2",
        "label": "OAuth 2.0 (delegated)",
        "note": "Sign in as a user via Microsoft Entra; request the scopes listed on each product below plus offline_access."
      },
      {
        "type": "oauth2",
        "label": "OAuth 2.0 (app-only)",
        "note": "Client credentials with https://graph.microsoft.com/.default; requires admin consent."
      }
    ],
    "guide": "Register an app in the [Microsoft Entra admin center](https://entra.microsoft.com) (App registrations → New registration). For user data, use the authorization-code flow against `https://login.microsoftonline.com/common/oauth2/v2.0/authorize` and request the product's scopes plus `offline_access` for refresh tokens. For daemons, use client credentials with the single scope `https://graph.microsoft.com/.default` and grant application permissions with admin consent. Every product below calls the same host with `Authorization: Bearer {access_token}`.",
    "sources": [
      {
        "title": "Microsoft Graph auth overview",
        "url": "https://learn.microsoft.com/graph/auth/"
      },
      {
        "title": "Microsoft Graph permissions reference",
        "url": "https://learn.microsoft.com/graph/permissions-reference"
      }
    ],
